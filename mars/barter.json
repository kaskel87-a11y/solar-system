{
  "format": "solar-system-story/mars-barter v1",
  "world": "Mars",
  "rating": "M (violence, crime, fictional drugs). No nudity or sexual content.",
  "fiction": "All contraband is fictional (glow-dust, hive resin). No real drugs, brands or companies.",
  "api": {
    "register": "SSX.contraband.registerOffer({id, npc, district, wants, gives, onTrade})",
    "trade": "SSX.contraband.barter(item, qty, offerId)",
    "bark": "SSX.bark(npc, 'barter_' + key) for key in lines (offer/accept/decline/caught); fall back to the line text."
  },
  "coords": "location is [x, z] AJ-relative (Ares Junction centre), world.js axes. AJ-core venues (Ozzie's Iron, Velvet Airlock, Cantina) use their existing anchors and the nearest district centre, Red Tape Flats.",
  "districts": {
    "olympus_row": {
      "centre_aj": [
        0,
        -430
      ],
      "pack_id": "mars-downtown"
    },
    "red_tape_flats": {
      "centre_aj": [
        -280,
        -40
      ],
      "pack_id": "mars-rough"
    },
    "helios_heights": {
      "centre_aj": [
        320,
        80
      ],
      "pack_id": "mars-gated"
    }
  },
  "schema": {
    "offer": "{id, npc, venue, district, location:[x,z], wants:[{item,qty}], gives:{type,...}, cooldownSec, repeatable, rep:{factions:[{faction,min}], missions_done?, flags?}, requires?, risk:{bust_chance, wanted_on_bust, wanted_on_trade, note?}, lines:{offer,accept,decline,caught}, tier?, wiredBy?}",
    "risk": "bust_chance 0..1 rolled per trade; on bust the wants are lost and wanted rises by wanted_on_bust; wanted_on_trade applies on success.",
    "repeatable": "false = one-time (unlocks, upgrades, heist tips); cooldownSec ignored."
  },
  "give_types": {
    "weapon": "Grant SHOP weapon id (game.js) plus starting ammo. Marsmania maps to engine shop grant.",
    "ammo_bundle": "Ammo by SHOP ammo id; onlyOwned=true skips guns the player lacks.",
    "wanted_clear": "Lower wanted by stars (world.setWanted(max(0, wanted - stars))).",
    "raid_tip": "Toast/radio warning before the next ColSec raid; Marsmania owns raid timing.",
    "venue_access": "Flag-based entry for venueId for durationSec (velvet_airlock_vip, the_static_door).",
    "garage_vehicle": "SSX.garage.grantVehicle(vehicleId, opts), e.g. opts {noPlates:true} (Pumpkin).",
    "garage_upgrade": "SSX.garage.grantUpgrade(upgradeId) (Pumpkin). ids match game.js SHOP upgrade/roverup ids.",
    "heist_tip": "heist.applyTip(heistId, tip) (Ben). tip = {type:'cameras'} | {type:'safe', ease:0.3} | {type:'patrol'}.",
    "gang_backup": "Spawn friendly faction escorts (count, durationSec). Needs Marsmania/CoS spawner; no-op if missing.",
    "chop": "Despawn current stolen vehicle, clear its heat, pay payoutCredits + bonusItems.",
    "unlock_job": "Unlock missionId (Jeff wires via registerOffer onTrade).",
    "item": "Add inventory item qty (catalog id)."
  },
